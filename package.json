{
  "name": "mowoo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "check:design": "node scripts/verify-design.mjs",
    "check:interactions": "node scripts/verify-interactions.mjs",
    "check:layout": "node scripts/verify-profile-layout.mjs",
    "check:navigation": "node scripts/verify-reading-navigation.mjs",
    "check:controls": "node scripts/verify-toggle-controls.mjs",
    "check:auth": "node scripts/verify-auth.mjs",
    "check:social-login": "node scripts/verify-social-login.mjs",
    "check:photo-attachments": "node scripts/verify-photo-attachments.mjs",
    "check:diary-pagination": "node scripts/verify-diary-pagination.mjs",
    "check:cloudflare-proxy": "node scripts/verify-cloudflare-proxy.mjs",
    "check:auth-refresh": "node scripts/verify-auth-refresh.mjs",
    "check:diary-emotions": "node scripts/verify-diary-emotions.mjs",
    "check:chat-delete": "node scripts/verify-chat-delete.mjs",
    "check:chat-improvements": "node scripts/verify-chat-improvements.mjs",
    "check:monthly-recap": "node scripts/verify-monthly-recap.mjs",
    "check:profile-api": "node scripts/verify-profile-api.mjs",
    "check:character-api": "node scripts/verify-character-api.mjs",
    "check:mypage-stats": "node scripts/verify-mypage-stats.mjs",
    "check:record-api": "node scripts/verify-record-api.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@fontsource/pretendard": "^5.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "typescript": "~5.7.3",
    "@playwright/test": "^1.51.0"
  }
}
